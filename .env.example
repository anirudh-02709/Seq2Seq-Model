# ==============================================================================
# MySQL Database Connection Configuration for NL2SQL Mini-Project
# ==============================================================================
# Copy this template to .env and configure your local MySQL credentials:
#   copy .env.example .env
#
# IMPORTANT:
# - Do not commit .env to version control.
# - Ensure credentials are kept confidential.
# ==============================================================================

# Database Host (default: localhost or 127.0.0.1)
MYSQL_HOST=localhost

# Database Port (default: 3306)
MYSQL_PORT=3306

# Database User Account (dedicated user or root)
MYSQL_USER=root

# Database User Password (replace with your MySQL instance password)
MYSQL_PASSWORD=your_mysql_password_here

# Database Name (default: nl2sql_student_db as created by nl2sql_student_db.sql)
MYSQL_DATABASE=nl2sql_student_db

# Connection Timeout in seconds (default: 5)
MYSQL_CONNECT_TIMEOUT=5

# Character Set Encoding (default: utf8mb4)
MYSQL_CHARSET=utf8mb4

# Automatic Transaction Commit (default: 0 / False)
MYSQL_AUTOCOMMIT=0

# ==============================================================================
# Dedicated Read-Only Execution User Configuration (Task 4.4)
# ==============================================================================
# The query execution layer strictly enforces least-privilege security and rejects
# execution using the 'root' account. Configure a dedicated read-only user below.
#
# To create this user in your MySQL server:
#   CREATE USER 'nl2sql_exec'@'localhost' IDENTIFIED BY 'your_exec_password_here';
#   GRANT SELECT ON nl2sql_student_db.* TO 'nl2sql_exec'@'localhost';
#   FLUSH PRIVILEGES;
# ==============================================================================

# Read-only execution database host (default: localhost)
MYSQL_EXEC_HOST=localhost

# Read-only execution database port (default: 3306)
MYSQL_EXEC_PORT=3306

# Dedicated read-only database username (must NOT be 'root')
MYSQL_EXEC_USER=nl2sql_exec

# Dedicated read-only database password
MYSQL_EXEC_PASSWORD=your_exec_password_here

# Target database name
MYSQL_EXEC_DATABASE=nl2sql_student_db

# Query connection timeout in seconds (default: 5)
MYSQL_EXEC_CONNECT_TIMEOUT=5

# Character set encoding (default: utf8mb4)
MYSQL_EXEC_CHARSET=utf8mb4

